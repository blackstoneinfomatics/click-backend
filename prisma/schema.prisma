generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum AuthProviderType {
  PHONE_OTP
  EMAIL_PASSWORD
  GOOGLE
  APPLE
}

enum AuthPlatform {
  RIDER_APP
  DRIVER_APP
  SUPER_ADMIN_WEB
}

model User {
  id String @id @default(uuid()) @db.Uuid

  firstName   String
  lastName    String?
  displayName String?

  email       String? @unique
  phoneNumber String? @unique

  avatarUrl   String?
  dateOfBirth DateTime?

  status UserStatus @default(ACTIVE)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  userRoles      UserRole[]
  authProviders  AuthProvider[]
  activeSessions ActiveSession[]

  @@index([status])
  @@map("users")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  name        String
  code        String  @unique
  description String?

  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  userRoles      UserRole[]
  activeSessions ActiveSession[] @relation("SessionActiveRole")

  @@index([isActive])
  @@map("roles")
}

model UserRole {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  roleId String @db.Uuid

  isActive Boolean @default(true)

  assignedAt DateTime @default(now())
  assignedBy String?

  revokedAt DateTime?
  revokedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AuthProvider {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  provider       AuthProviderType
  providerUserId String
  passwordHash   String?

  isPrimary   Boolean   @default(false)
  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_providers")
}

model ActiveSession {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  activeRoleId String? @db.Uuid

  deviceId         String
  accessTokenJti   String   @unique
  refreshTokenJti  String   @unique
  refreshTokenHash String
  refreshExpiresAt DateTime

  loginAt        DateTime  @default(now())
  lastAccessedAt DateTime?
  logoutAt       DateTime?

  ipAddress String?
  userAgent String?

  isRevoked Boolean   @default(false)
  revokedAt DateTime?

  country    String?
  appVersion String?
  platform   AuthPlatform

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeRole Role? @relation("SessionActiveRole", fields: [activeRoleId], references: [id], onDelete: Restrict)

  @@index([userId, isRevoked])
  @@index([deviceId])
  @@index([refreshExpiresAt])
  @@index([loginAt])
  @@map("active_sessions")
}
