# Application
APP_NAME="Click Bike Service"
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/click_bike_service"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# JWT
JWT_ACCESS_SECRET=click-bike-local-access-secret-change-before-production-2026
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=click-bike-local-refresh-secret-change-before-production-2026
JWT_REFRESH_EXPIRES_IN=7d